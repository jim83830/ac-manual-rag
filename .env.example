# 到 https://build.nvidia.com 登入後，在任一模型頁按「Get API Key」取得
NVIDIA_API_KEY=nvapi-請換成你的key

# OCR 改用 Google Gemini（Google AI Studio 免費 key）：三行一起取消註解
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# VISION_API_KEY=請換成你的Gemini key
# VISION_MODEL=gemini-模型名稱（用探測腳本列出可用清單）

# 以下可選：換模型或調參數時取消註解
# VISION_MODEL=google/gemma-4-31b-it
# CHAT_MODEL=z-ai/glm-5.3-flash
# CHAT_REASONING_EFFORT=low   # 換成非推理型模型時設為 off
# EMBED_MODEL=nvidia/nemotron-3-embed-1b
# RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
# RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking
# CHUNK_STRATEGY=heading
# CHUNK_MAX_CHARS=800
# RETRIEVE_K=10
# RERANK_K=3
# RERANK_THRESHOLD=-4.0
# OCR_WORKERS=4                # 同時 OCR 幾頁；Gemini 免費方案建議 1
# INGEST_MIN_INTERVAL=1.5      # ingest 每次呼叫 API 的最小間隔（秒）；Gemini 免費方案每分鐘 5 次，建議 13
